{
  "name": "geoverse",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check": "node tools/check-rules.mjs",
    "test": "node --test tests/*.test.mjs",
    "voice": "node tools/voice/generate.mjs",
    "story:new": "node tools/new-story.mjs",
    "skills:sync": "node tools/sync-skills.mjs",
    "extract-geo": "node tools/extract-geo.mjs",
    "smoke": "node tools/smoke.mjs",
    "shots": "node tools/smoke.mjs --shots tmp-shots"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
